# ==============================================================================
# Unibotics Environment Variable Template
# SECURITY: Never commit real keys or .env.local to version control!
# ==============================================================================

# Supabase (Public Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase (Server-Only Service Role - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Transactional Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Unibotics <contact@unibotics.in>"
ADMIN_ALERT_EMAIL=directorunibotics@gmail.com

# Cloudflare Turnstile Bot Defense
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Canonical Application URL
NEXT_PUBLIC_SITE_URL=https://unibotics.in
